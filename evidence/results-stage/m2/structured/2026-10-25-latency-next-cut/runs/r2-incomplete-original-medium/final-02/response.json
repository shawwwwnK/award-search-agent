ded.\",\n      \"reference_kind\": \"lead\",\n      \"reference_id\": \"A3\",\n      \"label\": \"Alaska economy lead\",\n      \"claims\": []\n    },\n    {\n      \"kind\": \"reference\",\n      \"text\": \"Jan 1 economy award summary; no complete schedule is provided.\",\n      \"reference_kind\": \"lead\",\n      \"reference_id\": \"A2\",\n      \"label\": \"United economy lead\",\n      \"claims\": []\n    },\n    {\n      \"kind\": \"reference\",\n      \"text\": \"Jan 1 economy award summary; no complete schedule is provided.\",\n      \"reference_kind\": \"lead\",\n      \"reference_id\": \"A1\",\n      \"label\": \"Aeroplan economy lead\",\n      \"claims\": []\n    },\n    {\n      \"kind\": \"narrative\",\n      \"text\": \"If you could start from Taipei, a business-class lead exists for TPE–Bangkok on Dec 31, before the requested January window. A separate Jan 1 SFO–Taipei economy lead could suggest a positioning route, but it is not an onward itinerary. Together, these records do not show a workable connection or a complete SFO–Bangkok trip.\",\n      \"reference_kind\": null,\n      \"reference_id\": null,\n      \"label\": null,\n      \"claims\": []\n    },\n    {\n      \"kind\": \"reference\",\n      \"text\": \"Business-class segment lead dated Dec 31, outside the requested departure window.\",\n      \"reference_kind\": \"lead\",\n      \"reference_id\": \"A108\",\n      \"label\": \"Taipei business-class lead\",\n      \"claims\": []\n    },\n    {\n      \"kind\": \"reference\",\n      \"text\": \"Jan 1 SFO–Taipei economy lead; no onward schedule is supplied.\",\n      \"reference_kind\": \"lead\",\n      \"reference_id\": \"A277\",\n      \"label\": \"Taipei positioning lead\",\n      \"claims\": []\n    },\n    {\n      \"kind\": \"narrative\",\n      \"text\": \"These award observations were recorded on Oct 9, 2026, not checked in real time. Their summaries do not verify current award availability, schedules, connection protection, or bookability; the award price scope is also unknown. Treat the Taipei possibility as a direction for further searching, not as a confirmed substitute. The cash fare is likewise a dated quote with unknown price scope, not a confirmed party total or per-traveler price.\"\n,\n      \"reference_kind\": null,\n      \"reference_id\": null,\n      \"label\": null,\n      \"claims\": []\n    }\n  ]\n}",
